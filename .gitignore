# ==============================================================================
# Pocket Root .gitignore
# ==============================================================================

# --- Environment & Secret Configuration ---
.env
.env.*
!.env.example

# --- Application Data & Local Storage (Personal Cloud files) ---
data/
storage/
user_files/
tmp/
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python Test & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# --- Node.js & Angular Web ---
node_modules/
web/node_modules/
.angular/
web/.angular/
web/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- IDE & Text Editors ---
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
# Ignore user-specific vscode files, but keep shared settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Docker & Logs ---
*.log
